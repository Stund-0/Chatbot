# ============================================
# Configuración del Chatbot WhatsApp
# ============================================

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=chatbot123
WHATSAPP_API_VERSION=v22.0

# OpenAI (opcional, para interprete avanzado)
OPENAI_API_KEY=

# Administrador
ADMIN_TELEFONO=
ADMIN_CORREO=

# Base de datos: dejar vacío para SQLite local, o usar URL de PostgreSQL
DATABASE_URL=

# Redis (para rate limiter compartido entre workers, ej: REDIS_URL=redis://...)
# Si no se configura, usa memoria local (no compartida entre workers)
REDIS_URL=

# Autenticación para endpoints /reportes/*
REPORTES_API_KEY=

# Modo simulación = true para pruebas sin WhatsApp real
MODO_SIMULACION=true
DEBUG=false

# Logging: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
# Formato: json (producción) o text (desarrollo)
LOG_FORMAT=json

# PostgreSQL pool (opcional)
PG_POOL_MIN=2
PG_POOL_MAX=10

# Zona horaria (opcional, default America/Mexico_City)
TZ=America/Mexico_City

# Horario laboral (opcional, formato "inicio-fin" en horas decimales)
HORARIO_WEEKDAY=8-18
HORARIO_SATURDAY=9-14

# Gunicorn (opcional)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
